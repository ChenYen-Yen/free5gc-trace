{
  "id": null,
  "uid": "nf-latency-compare",
  "title": "NF Latency — Prometheus + Tempo",
  "tags": ["latency", "tempo", "prometheus", "nf"],
  "timezone": "",
  "schemaVersion": 27,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Prometheus: p95 / p99 request latency",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(${metric}_bucket{nf_type=~\"${nf:regex}\"}[5m])) by (le, nf_type))",
          "format": "time_series",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(${metric}_bucket{nf_type=~\"${nf:regex}\"}[5m])) by (le, nf_type))",
          "format": "time_series",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "description": "Shows Prometheus-derived p95/p99 from the selected histogram metric (choose `Histogram Metric` variable). The dashboard queries `${metric}_bucket` (Prometheus histogram buckets). Choose an NF and metric that match your exported metrics."
    },
    {
      "type": "timeseries",
      "title": "Per-NF p95 (compare multiple NFs)",
      "id": 2,
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(${metric}_bucket{nf_type=~\"${nf:regex}\"}[5m])) by (le, nf_type))",
          "format": "time_series",
          "legendFormat": "{{nf_type}}",
          "refId": "C"
        }
      ],
      "description": "Quick comparison p95 across AMF/AUSF/UDM/UDR/NSSF/NRF/SMF/UPF. Tweak job label to match your Prometheus target labels."
    },
    {
      "type": "table",
      "title": "Top SBI APIs by p95 (example)",
      "id": 3,
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum(rate(${metric}_bucket{nf_type=~\"${nf:regex}\"}[5m])) by (le, api)))",
          "format": "table",
          "instant": false,
          "legendFormat": "{{api}}",
          "refId": "D"
        }
      ],
      "options": { "showHeader": true },
      "description": "Example table showing top APIs by p95 derived from histogram buckets. Replace label `api` with the label your metrics export (for example `handler` or `endpoint`)."
    },
    {
      "type": "text",
      "title": "Tempo per-span latency — quick links & example query",
      "id": 4,
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 6 },
      "options": {
        "content": "### Per-span latency (Tempo)\n\nUse Grafana Explore (Traces) to inspect per-span latencies by service and operation. Example trace query: <code>{resource.service.name=\\\"amf\\\"}</code>.\n\nCommon NF service names: amf, ausf, udm, udr, nssf, nrf, smf, pcf\n\nNotes:\n- Tempo shows exact span durations and parent-child relationships.\n- Use the Prometheus panels above to spot the slow NF, then click through traces in Explore to find slow spans / SBI APIs.\n- TraceQL syntax: {resource.service.name=\\\"nf_name\\\"} duration > 100ms",
        "mode": "markdown"
      },
      "transparent": false
    },
    {
      "type": "table",
      "title": "Tempo: Recent Traces",
      "id": 5,
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 14 },
      "datasource": "Tempo",
      "targets": [
        {
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${nf:regex}\"}",
          "limit": 50,
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "traceID": "Trace ID",
              "traceName": "Name",
              "startTime": "Start Time",
              "duration": "Duration"
            }
          }
        }
      ],
      "description": "Recent traces from Tempo. Click trace ID to view details in Explore."
    }
  ],
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "nf",
        "label": "Network Function",
        "query": "amf,ausf,udm,udr,nssf,nrf,smf,upf",
        "current": { "text": "amf,ausf,udm,udr,nssf,nrf,smf,upf", "value": "amf,ausf,udm,udr,nssf,nrf,smf,upf" },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "type": "custom",
        "name": "metric",
        "label": "Histogram Metric",
        "query": "free5gc_sbi_inbound_request_duration_seconds,free5gc_sbi_outbound_request_duration_seconds,free5gc_amf_business_ue_gmm_state_duration_seconds",
        "current": { "text": "free5gc_sbi_inbound_request_duration_seconds", "value": "free5gc_sbi_inbound_request_duration_seconds" },
        "multi": false,
        "includeAll": false,
        "refresh": 1
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"] }
}
