{
  "id": null,
  "uid": "nf-latency-compare",
  "title": "NF Latency — Prometheus + Tempo",
  "tags": ["latency", "tempo", "prometheus", "nf"],
  "timezone": "",
  "schemaVersion": 27,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "row",
      "title": "📊 Load & Latency Overview",
      "id": 100,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Request Rate (req/s) - Shows UE Registration Load",
      "id": 10,
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(${metric}_count{nf_type=~\"${nf:regex}\"}[1m])) by (nf_type)",
          "format": "time_series",
          "legendFormat": "{{nf_type}}",
          "refId": "A"
        }
      ],
      "description": "Request rate per NF. High spikes indicate multiple concurrent UE registrations."
    },
    {
      "type": "stat",
      "title": "Current Trace Rate",
      "id": 11,
      "refresh": "30s",
      "cacheTimeout": "60s",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 6 },
      "datasource": "Tempo",
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name=~\"${nf:regex}\" }",
          "limit": 100,
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 50, "color": "yellow" },
              { "value": 100, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["count"]
          }
        }
      ],
      "description": "Number of traces in current time window. Each trace ≈ one UE registration flow."
    },
    {
      "type": "timeseries",
      "title": "SBI Latency p95/p99 by NF",
      "id": 1,
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(${metric}_bucket{nf_type=~\"${nf:regex}\"}[1m])) by (le, nf_type))",
          "format": "time_series",
          "legendFormat": "p95 {{nf_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(${metric}_bucket{nf_type=~\"${nf:regex}\"}[1m])) by (le, nf_type))",
          "format": "time_series",
          "legendFormat": "p99 {{nf_type}}",
          "refId": "B"
        }
      ],
      "description": "P95/P99 latency by NF. Compare with left panel: when request rate spikes (multiple UEs), does latency increase?"
    },
    {
      "type": "row",
      "title": "📈 Latency vs Load Correlation Analysis",
      "id": 101,
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Latency vs Request Rate Overlay (KEY PANEL for Multi-UE Analysis)",
      "id": 12,
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 9 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*rate.*" },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 30
              },
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "semi-dark-blue" }
              }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*p95.*" },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              },
              {
                "id": "color",
                "value": { "mode": "palette-classic" }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "last"]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(${metric}_bucket{nf_type=~\"${nf:regex}\"}[1m])) by (le, nf_type))",
          "format": "time_series",
          "legendFormat": "p95 {{nf_type}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(${metric}_count{nf_type=~\"${nf:regex}\"}[1m])) by (nf_type)",
          "format": "time_series",
          "legendFormat": "rate {{nf_type}}",
          "refId": "B"
        }
      ],
      "description": "KEY PANEL: Shows p95 latency (left axis, colored lines) overlaid with request rate (right axis, blue filled). When rate spikes due to multiple UE registrations, check if latency also increases - this indicates load-sensitive behavior."
    },
